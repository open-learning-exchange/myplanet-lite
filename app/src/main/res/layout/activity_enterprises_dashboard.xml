<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/enterprisesDashboardDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/enterprisesDashboardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/enterprisesDashboardAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:elevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="4dp"
                android:minHeight="@dimen/dashboard_top_bar_height"
                android:paddingStart="@dimen/dashboard_horizontal_padding"
                android:paddingTop="@dimen/dashboard_top_padding"
                android:paddingEnd="@dimen/dashboard_horizontal_padding"
                android:paddingBottom="@dimen/dashboard_top_bar_bottom_padding">

                <ImageView
                    android:id="@+id/enterprisesDashboardAvatar"
                    android:layout_width="@dimen/dashboard_avatar_size"
                    android:layout_height="@dimen/dashboard_avatar_size"
                    android:background="@drawable/avatar_placeholder_background"
                    android:clipToOutline="true"
                    android:contentDescription="@string/dashboard_avatar_content_description"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="@dimen/dashboard_logo_size"
                    android:layout_height="@dimen/dashboard_logo_size"
                    android:contentDescription="@string/dashboard_logo_content_description"
                    android:scaleType="centerInside"
                    android:src="@drawable/ole_logo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/enterprisesDashboardSettings"
                    android:layout_width="@dimen/dashboard_icon_button_size"
                    android:layout_height="@dimen/dashboard_icon_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dashboard_settings_content_description"
                    android:padding="@dimen/dashboard_icon_padding"
                    android:src="@drawable/ic_settings_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:id="@+id/enterprisesDashboardContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/enterprisesListContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/enterprisesTeamsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:visibility="gone"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <FrameLayout
            android:id="@+id/enterprisesTasksContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:visibility="gone"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <LinearLayout
            android:id="@+id/enterprisesBottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dashboard_horizontal_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/dashboard_horizontal_padding"
            android:paddingBottom="12dp"
            app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior">

            <ImageView
                android:id="@+id/enterprisesNavigationIcon"
                android:layout_width="@dimen/dashboard_icon_button_size"
                android:layout_height="@dimen/dashboard_icon_button_size"
                android:layout_marginHorizontal="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/enterprises_title"
                android:padding="@dimen/dashboard_icon_padding"
                android:scaleType="center"
                android:src="@drawable/ic_enterprises_24" />

            <ImageView
                android:id="@+id/enterprisesTeamsNavigationIcon"
                android:layout_width="@dimen/dashboard_icon_button_size"
                android:layout_height="@dimen/dashboard_icon_button_size"
                android:layout_marginHorizontal="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dashboard_enterprise_members_title"
                android:padding="@dimen/dashboard_icon_padding"
                android:scaleType="center"
                android:src="@drawable/ic_groups_24" />

            <ImageView
                android:id="@+id/enterprisesTasksNavigationIcon"
                android:layout_width="@dimen/dashboard_icon_button_size"
                android:layout_height="@dimen/dashboard_icon_button_size"
                android:layout_marginHorizontal="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dashboard_enterprise_tasks_title"
                android:padding="@dimen/dashboard_icon_padding"
                android:scaleType="center"
                android:src="@drawable/ic_course_step_survey_24" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/enterprisesProfileDrawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_dashboard_profile_header"
        app:itemIconPadding="@dimen/dashboard_drawer_item_icon_padding"
        app:itemTextAppearance="@style/TextAppearance.MyPlanet.DashboardDrawerItem"
        app:menu="@menu/menu_dashboard_profile_drawer" />

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/enterprisesSettingsDrawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_dashboard_settings_header"
        app:itemIconPadding="@dimen/dashboard_drawer_item_icon_padding"
        app:itemTextAppearance="@style/TextAppearance.MyPlanet.DashboardDrawerItem"
        app:menu="@menu/menu_dashboard_settings_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
